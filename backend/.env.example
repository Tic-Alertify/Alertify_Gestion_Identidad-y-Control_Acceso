# ─── Base de Datos SQL Server (Azure SQL recomendado) ────────────────────────
# Runtime (Nest + PrismaMssql adapter)
DB_HOST=alertify-server-johan-2.database.windows.net
DB_PORT=1433
DB_NAME=AlertifyDB
DB_USER=adminAlertify
DB_PASSWORD=CAMBIAR_POR_PASSWORD_SEGURA

# TLS (Azure SQL)
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=false

# URL para el CLI de Prisma (migraciones/seed)
# Importante: URL-encode de password si contiene caracteres especiales.
# Ejemplo: % -> %25, & -> %26
DATABASE_URL="sqlserver://alertify-server-johan-2.database.windows.net:1433;database=AlertifyDB;user=adminAlertify;password=CAMBIAR_POR_PASSWORD_URL_ENCODED;encrypt=true;trustServerCertificate=false"

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Genera un secreto seguro: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=cambia-este-secreto-por-uno-seguro-de-al-menos-32-caracteres
JWT_EXPIRATION=1h

# ─── Servidor ────────────────────────────────────────────────────────────────
PORT=3000
